# Copy to .env and fill in. Never commit .env.

# --- Ingest ---
LW_CAMERA_LIST_URL=https://webcams.nyctmc.org/api/cameras/
LW_AREA=penn                     # penn | times_square | midtown
LW_POLL_INTERVAL_S=2.0           # live pipeline; recorder uses 5 s
LW_DATA_DIR=data

# Backup camera source (register early, approval takes time)
NY511_API_KEY=

# --- Vision ---
LW_YOLO_WEIGHTS=yolo11s.pt       # swap for the fine-tuned weights path
LW_DETECT_CONF=0.35
# "", "cpu", "mps", "0" (cuda)
LW_DEVICE=

# --- API ---
LW_DATABASE_URL=sqlite:///data/lanewatch.db
LW_MOCK_MODE=true                # serve data/mock/*.json until the pipeline is live
LW_DATA_SOURCE=live              # live | replay: the dashboard shows LIVE or REPLAY for real events

# --- Dashboard ---
LW_API_URL=http://localhost:8000 # the web dashboard's dev server proxies /api here

# --- Simulation ---
# e.g. /opt/homebrew/opt/sumo/share/sumo
SUMO_HOME=

# --- Summaries (optional, F12) ---
ANTHROPIC_API_KEY=
LW_SUMMARY_MODEL=claude-opus-5

# --- Open data (optional, raises Socrata rate limits) ---
SOCRATA_APP_TOKEN=
