# Copy to deploy/.env on the server. Never commit deploy/.env.

# The API's address; its DNS A record points at this server.
API_DOMAIN=api.ellipsisnyc.tech
# The site that reads the API from the browser.
LW_CORS_ORIGINS=https://ellipsisnyc.tech,https://www.ellipsisnyc.tech

# Incident notes and spoken alerts; leave a key empty to turn that off.
GEMINI_API_KEY=
# Each model has its own free quota; switch models when one runs out for the day.
LW_GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
# Paid calls per day (0 = no limit). Gemini's free tier allows 20 a day per model.
LW_NOTES_PER_DAY=18
LW_VOICE_PER_DAY=40
